FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json ./
COPY frontend/package.json ./frontend/
COPY backend/packages/shared/package.json ./backend/packages/shared/
COPY frontend/ui/package.json ./frontend/ui/
COPY backend/packages/validation/package.json ./backend/packages/validation/

RUN npm install

COPY backend/packages/shared ./backend/packages/shared
COPY backend/packages/validation ./backend/packages/validation
COPY frontend ./frontend

RUN npm run build:web

FROM nginx:alpine
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY backend/infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
