ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE} AS server

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY backend/agent/package.json ./backend/agent/
COPY frontend/package.json ./frontend/
COPY frontend/ui/package.json ./frontend/ui/
COPY dicktob/package.json ./dicktob/
COPY backend/packages/shared/package.json ./backend/packages/shared/
COPY backend/packages/domain/package.json ./backend/packages/domain/
COPY backend/packages/validation/package.json ./backend/packages/validation/
COPY backend/packages/obs-client/package.json ./backend/packages/obs-client/

RUN npm ci --no-audit --omit=dev --workspace=@mcr/server --workspace=@mcr/shared --workspace=@mcr/domain --workspace=@mcr/validation --workspace=@mcr/obs-client

COPY backend ./backend
RUN mkdir -p backend/database/sqlite \
    && chown node:node backend/database/sqlite \
    && chmod 0700 backend/database/sqlite

EXPOSE 4000
CMD ["node", "backend/src/index.js"]

FROM server AS iptv
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-gi gir1.2-gstreamer-1.0 gir1.2-gdkpixbuf-2.0 \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
    ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/bin/python3 -c 'import gi; gi.require_version("Gst", "1.0"); gi.require_version("GdkPixbuf", "2.0"); from gi.repository import Gst, GdkPixbuf; Gst.init(None)' \
    && for element in x264enc avenc_aac intervideosrc gdkpixbufoverlay mpegtsmux tsdemux srtsink souphttpsrc; do \
        gst-inspect-1.0 "$element" >/dev/null || exit 1; \
    done

FROM server AS default
