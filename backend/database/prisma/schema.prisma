datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SUPER_ADMIN
  ORG_ADMIN
  STUDIO_MANAGER
  OPERATOR
  VIEWER
}

enum StationStatusEnum {
  ONLINE
  OFFLINE
  DEGRADED
  CONNECTING
}

enum StreamStatusEnum {
  STOPPED
  STARTING
  STREAMING
  STOPPING
}

enum RecordStatusEnum {
  STOPPED
  STARTING
  RECORDING
  PAUSED
  STOPPING
}

model Organization {
  id             String               @id @default(uuid())
  name           String
  slug           String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  members        OrganizationMember[]
  studios        Studio[]
  stations       Station[]
  stationGroups  StationGroup[]
  auditLogs      AuditLog[]
  macros         Macro[]
  schedules      Schedule[]
  systemSettings SystemSetting[]

  @@index([slug])
}

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  passwordHash    String
  fullName        String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  memberships     OrganizationMember[]
  sessions        UserSession[]
  auditLogs       AuditLog[]

  @@index([email])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           RoleType     @default(VIEWER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Studio {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stations       Station[]

  @@index([organizationId])
}

model Station {
  id                  String             @id @default(uuid())
  organizationId      String
  studioId            String?
  name                String
  slug                String
  description         String?
  ipAddress           String             @default("127.0.0.1")
  obsPort             Int                @default(4455)
  encryptedPassword   String?            @db.Text
  status              StationStatusEnum  @default(OFFLINE)
  streamStatus        StreamStatusEnum   @default(STOPPED)
  recordStatus        RecordStatusEnum   @default(STOPPED)
  currentProgramScene String?
  currentPreviewScene String?
  fps                 Float              @default(0.0)
  cpuUsage            Float              @default(0.0)
  memoryUsage         Float              @default(0.0)
  droppedFrames       Int                @default(0)
  lastHeartbeat       DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studio              Studio?            @relation(fields: [studioId], references: [id], onDelete: SetNull)
  agent               StationAgent?
  groupMembers        StationGroupMember[]
  pairingTokens       DevicePairingToken[]
  macroActions        MacroAction[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model StationAgent {
  id              String    @id @default(uuid())
  stationId       String    @unique
  agentVersion    String
  machineHostname String
  osPlatform      String
  authTokenHash   String    @db.VarChar(255)
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  station         Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
}

model StationGroup {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  description    String?
  color          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        StationGroupMember[]

  @@index([organizationId])
}

model StationGroupMember {
  id             String       @id @default(uuid())
  stationGroupId String
  stationId      String

  stationGroup   StationGroup @relation(fields: [stationGroupId], references: [id], onDelete: Cascade)
  station        Station      @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationGroupId, stationId])
}

model DevicePairingToken {
  id              String    @id @default(uuid())
  stationId       String
  pairingCode     String    // 8-character human-friendly code
  tokenHash       String    @db.VarChar(255)
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  station         Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([pairingCode])
  @@index([tokenHash, expiresAt])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @db.VarChar(255)
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Macro {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  shortcutKey    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actions        MacroAction[]

  @@index([organizationId])
}

model MacroAction {
  id            String   @id @default(uuid())
  macroId       String
  stationId     String?
  actionType    String
  parameters    Json
  sequenceOrder Int      @default(0)
  delayMs       Int      @default(0)

  macro         Macro    @relation(fields: [macroId], references: [id], onDelete: Cascade)
  station       Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([macroId, sequenceOrder])
}

model Schedule {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  cronExpression String
  actionType     String
  payload        Json
  isEnabled      Boolean      @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isEnabled])
}

model SystemSetting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}
