# Copy this template to backend/.env for local development.
NODE_ENV=development
PORT=4000
MCR_BIND_HOST=127.0.0.1
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
# Optional comma-separated ingress proxy IPs or nonzero CIDRs.
MCR_TRUST_PROXY_CIDRS=
STORAGE_MODE=sqlite
MCR_MEDIA_STATION_QUOTA_MIB=512

# Supply distinct private values for network-bound and production deployments.
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ENCRYPTION_MASTER_KEY=
MCR_ADMIN_PASSWORD=

# Optional for administrator-configured HTTPS Program input.
# Required for HTTPS Program input when the API is network-bound.
# MCR_PROGRAM_INPUT_URL=https://source.example.test/feed
# MCR_PROGRAM_INPUT_EGRESS_PROXY=http://127.0.0.1:3128
# Keep UDP on loopback by default. For an isolated trusted LAN, configure an assigned
# private IPv4 address and restrict the contribution port to authorized senders in the firewall.
# MCR_PROGRAM_INPUT_HOST=127.0.0.1
# MCR_PROGRAM_TRUST_PRIVATE_UDP=0
# Keep per-installation keys stable before saving station credentials or running separate processes.
# For an authorized migration of the legacy bootstrap account, configure the new
# MCR_ADMIN_PASSWORD and provide MCR_PREVIOUS_ADMIN_PASSWORD for one startup only.
